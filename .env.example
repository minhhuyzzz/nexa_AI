NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth / Security
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# AI Services
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Storage (Supabase Storage Bucket)
NEXT_PUBLIC_STORAGE_BUCKET=nexa-assets

# Payment Gateway (PayOS / VietQR)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# Transaction Auto-Reconciliation Secret
RECONCILIATION_CRON_SECRET=your-random-cron-secret-32-chars

# Email Service (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=NEXA Platform <onboarding@resend.dev>

# Super Admin (Chủ sở hữu tối cao của nền tảng)
SUPER_ADMIN=
